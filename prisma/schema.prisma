// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  phone     String?  @unique
  password  String
  name      String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member    Member?
}

model Member {
  id            String        @id @default(cuid())
  wfcId         String        @unique
  firstName     String
  lastName      String
  phone         String?
  email         String?
  photo         String?
  region        String        // Kanda
  district      String?       // Halmashauri
  branch        String?       // Tawi
  status        MemberStatus  @default(ACTIVE)
  joinedAt      DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  userId        String?       @unique
  user          User?         @relation(fields: [userId], references: [id])

  contributions Contribution[]
  eventReports  Event[]       @relation("ReportedEvents")
}

model Contribution {
  id          String   @id @default(cuid())
  type        String   // Kiingilio, Ada ya mwezi, Dharura, Msiba, Harusi, etc.
  amount      Int
  month       String?  // e.g. "2026-11"
  method      String?  // M-Pesa, Tigo, Airtel, Benki
  reference   String?
  status      String   @default("PENDING") // PENDING, CONFIRMED, REJECTED
  paidAt      DateTime?
  createdAt   DateTime @default(now())

  memberId    String
  member      Member   @relation(fields: [memberId], references: [id])
}

model Event {
  id          String   @id @default(cuid())
  type        String   // Msiba, Ugonjwa, Harusi
  title       String
  description String?
  location    String?
  targetAmount Int?
  raisedAmount Int     @default(0)
  status      String   @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  reportedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  reporterId  String?
  reporter    Member?  @relation("ReportedEvents", fields: [reporterId], references: [id])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  CHAIRPERSON
  SECRETARY
  TREASURER
  COMMITTEE
  REGIONAL_LEADER
  MEMBER
}

enum MemberStatus {
  ACTIVE
  PENDING
  SUSPENDED
  WITHDRAWN
}
